# ===================
# Railway Deployment
# ===================
# These are automatically set by Railway when you link a PostgreSQL database:
# DATABASE_URL - Connection string with connection pooling (for queries)
# DIRECT_URL - Direct connection string (for migrations)

# Database (Railway sets these automatically when you add PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/shiftsync?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/shiftsync?schema=public"

# NextAuth.js
# IMPORTANT: Set NEXTAUTH_URL to your Railway domain (e.g., https://shiftsync.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Generate NEXTAUTH_SECRET with:
# openssl rand -base64 32

# ===================
# Stripe Billing
# ===================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook secret - get from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs - Create these in Stripe Dashboard > Products
# Create a product called "Pro Plan" with monthly recurring price of $29
STRIPE_PRO_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_..."

# Create a product called "Enterprise Plan" with monthly recurring price of $99
STRIPE_ENTERPRISE_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID="price_..."

# Your app's public URL (for Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===================
# Optional Integrations
# ===================

# OAuth Providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email Provider (for notifications)
# EMAIL_SERVER_HOST=""
# EMAIL_SERVER_PORT=""
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM=""

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# OpenAI (AI scheduling assistant)
# OPENAI_API_KEY=""
