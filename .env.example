# ===================
# Railway Deployment
# ===================
# These are automatically set by Railway when you link a PostgreSQL database:
# DATABASE_URL - Connection string with connection pooling (for queries)
# DIRECT_URL - Direct connection string (for migrations)

# ===================
# Docker Compose Deployment
# ===================
# For Docker Compose, use: postgresql://scheduleos:scheduleos_secret@db:5432/scheduleos
# POSTGRES_USER="scheduleos"
# POSTGRES_PASSWORD="scheduleos_secret"
# POSTGRES_DB="scheduleos"

# Database (Railway sets these automatically when you add PostgreSQL)
# Connection pooling parameters (append to DATABASE_URL):
#   - connection_limit=20   (max connections, default 10)
#   - pool_timeout=30       (seconds to wait for connection)
# Example with pooling:
#   DATABASE_URL="postgresql://user:password@localhost:5432/scheduleos?schema=public&connection_limit=20&pool_timeout=30"
#
# For serverless deployments (Vercel, AWS Lambda), consider:
#   - Using PgBouncer as a connection pooler
#   - Using Prisma Accelerate for managed connection pooling
DATABASE_URL="postgresql://user:password@localhost:5432/scheduleos?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/scheduleos?schema=public"

# NextAuth.js
# IMPORTANT: Set NEXTAUTH_URL to your Railway domain (e.g., https://shiftsync.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Generate NEXTAUTH_SECRET with:
# openssl rand -base64 32

# ===================
# Optional Integrations
# ===================

# OAuth Providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email Provider (for password reset and notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@yourdomain.com"
SMTP_SECURE="false"

# Setup Key (required for initial organization setup)
# Generate with: openssl rand -base64 32
SETUP_KEY=""

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# OpenAI (AI scheduling assistant)
# OPENAI_API_KEY=""
