# ===================
# Railway Deployment
# ===================
# Railway sets DATABASE_URL automatically when you link a PostgreSQL service.
# DIRECT_URL must be set by hand (same value unless you use a connection pooler);
# Prisma uses it for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/shiftsync?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/shiftsync?schema=public"

# NextAuth.js
# IMPORTANT: Set NEXTAUTH_URL to your Railway domain (e.g., https://shiftsync.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Generate NEXTAUTH_SECRET with:
# openssl rand -base64 32

# Shadow database for `npm run db:migrate:check` / `prisma migrate dev` (local only).
# An empty database Prisma can create and drop tables in. Never point this at production.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/shiftsync_shadow?schema=public"

# Secret the cron job sends as `x-cron-secret` to POST /api/attendance/auto-checkout
# Generate with: openssl rand -base64 32
# CRON_SECRET=""

# ===================
# Optional Integrations
# ===================

# Upstash Redis (recommended for production — enables distributed rate limiting)
# Get these from https://console.upstash.com after creating a Redis database
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Sentry (error monitoring)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Stripe (payments & subscriptions)
# Get these from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_ENABLED="true"
# Stripe Price IDs — create products in Stripe Dashboard → Products
# STRIPE_STARTER_PRICE_ID=""
# STRIPE_PRO_PRICE_ID=""
# STRIPE_ENTERPRISE_PRICE_ID=""

# Anthropic (AI scheduling assistant)
# ANTHROPIC_API_KEY=""

# OAuth Providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email Provider (Resend - recommended)
# Get your API key from https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="ScheduleOS <noreply@yourdomain.com>"

# Legacy SMTP (alternative to Resend)
# EMAIL_SERVER_HOST=""
# EMAIL_SERVER_PORT=""
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# OpenAI (AI scheduling assistant)
# OPENAI_API_KEY=""
