# ===================
# Railway Deployment
# ===================
# These are automatically set by Railway when you link a PostgreSQL database:
# DATABASE_URL - Connection string with connection pooling (for queries)
# DIRECT_URL - Direct connection string (for migrations)

# Database (Railway sets these automatically when you add PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/shiftsync?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/shiftsync?schema=public"

# NextAuth.js
# IMPORTANT: Set NEXTAUTH_URL to your Railway domain (e.g., https://shiftsync.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Generate NEXTAUTH_SECRET with:
# openssl rand -base64 32

# Setup/migration key (required for /api/setup and /api/migrate)
SETUP_KEY=""

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===================
# Optional Integrations
# ===================

# OAuth Providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email Provider (Resend - recommended)
# Get your API key from https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="ShiftSync <noreply@yourdomain.com>"
SUPPORT_EMAIL="support@yourdomain.com"

# Legacy SMTP (alternative to Resend)
# EMAIL_SERVER_HOST=""
# EMAIL_SERVER_PORT=""
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# AI Assistant (Claude)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# OpenAI (alternative AI provider)
# OPENAI_API_KEY=""

# ===================
# Billing (Stripe)
# ===================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
STRIPE_TRIAL_DAYS="14"
