// ShiftSync Database Schema
// AI-Powered Workforce Scheduling Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// Authentication & Users
// =====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// Core Business Entities
// =====================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  subscriptionTier   SubscriptionTier @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  workerLimit        Int              @default(5)      // Max workers allowed
  trialEndsAt        DateTime?                         // When trial expires
  subscriptionEndsAt DateTime?                         // Current billing period end
  stripeCustomerId   String?          @unique          // For Stripe integration
  stripeSubscriptionId String?        @unique

  // Relations
  users            User[]
  crews            Crew[]
  departments      Department[]
  rotationPatterns RotationPattern[]
  staffingRules    StaffingRule[]
  shutdowns        Shutdown[]
  holidays         Holiday[]
  invitations      Invitation[]
  customShiftTypes CustomShiftType[]
  customRoles      CustomRole[]
  aiChatSessions   AIChatSession[]
  certificationTypes CertificationType[]
  auditLogs        AuditLog[]
  shiftSwapRequests ShiftSwapRequest[]
}

// Subscription tiers with worker limits
enum SubscriptionTier {
  TRIAL      // 5 workers, 14 days
  STARTER    // 15 workers, $39/mo
  GROWTH     // 40 workers, $79/mo
  PRO        // 100 workers, $149/mo
  BUSINESS   // Unlimited, $299/mo
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// Department - allows Enterprise orgs to have separate calendars/teams
model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3B82F6")
  isDefault   Boolean  @default(false) // First department created is default
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  users User[]
  crews Crew[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  image          String?
  role           UserRole     @default(WORKER)
  position       String?
  positionType   PositionType @default(OTHER)
  phone          String?
  hireDate       DateTime?
  status         UserStatus   @default(ACTIVE)
  sortOrder      Int?         // Custom sort order for schedule display
  // Operator training/certification flags
  isControlRoomTrained Boolean @default(false) // Trained for control room duties
  isOilOperatorTrained Boolean @default(false) // Trained as Oil Operator
  isUtilityOperatorTrained Boolean @default(false) // Trained as Utility Operator
  isGasOperatorTrained Boolean @default(false) // Trained as Gas Operator
  includeInStaffingCount Boolean @default(true) // Include this worker in staffing counts/calculations
  singleTrainingCoverageOnly Boolean @default(false) // When true, can only count toward ONE training coverage per shift
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Organization
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Department (for Enterprise multi-department support)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Crew assignment
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id])

  // Custom role (optional, for display/organization purposes)
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  // Relations
  accounts        Account[]
  sessions        Session[]
  schedules       Schedule[]
  timeOffRequests TimeOffRequest[]
  approvedRequests TimeOffRequest[] @relation("ApprovedBy")
  holidayTracking HolidayTracking[]
  notifications   Notification[]
  createdInvitations Invitation[] @relation("InvitationCreator")
  aiChatSessions  AIChatSession[]
  certifications  UserCertification[]
  auditLogs       AuditLog[]
  swapRequestsMade     ShiftSwapRequest[] @relation("SwapRequester")
  swapRequestsReceived ShiftSwapRequest[] @relation("SwapTarget")
  swapRequestsApproved ShiftSwapRequest[] @relation("SwapApprover")

  @@index([organizationId])
  @@index([departmentId])
  @@index([crewId])
}

enum UserRole {
  ADMIN
  SUPERVISOR
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

// Position types for categorizing workers
enum PositionType {
  OPERATOR
  ONSHORE_CONTROL_ROOM
  OTHER
}

model Crew {
  id           String   @id @default(cuid())
  name         String
  description  String?
  color        String   @default("#3B82F6")
  currentPhase Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Department (for Enterprise multi-department support)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Rotation Pattern
  rotationPatternId String?
  rotationPattern   RotationPattern? @relation(fields: [rotationPatternId], references: [id])

  // Relations
  workers       User[]
  schedules     Schedule[]
  staffingRules StaffingRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([departmentId])
}

model RotationPattern {
  id                String   @id @default(cuid())
  name              String
  description       String?
  daysOn            Int
  daysOff           Int
  includesNights    Boolean  @default(false)
  nightsAtStart     Boolean  @default(true)
  nightDays         Int      @default(0)
  alternatesShifts  Boolean  @default(false)  // When true, work periods alternate between all-DAY and all-NIGHT
  patternDefinition Json     @default("[]")
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  crews Crew[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// =====================
// Scheduling
// =====================

model Schedule {
  id             String      @id @default(cuid())
  date           DateTime    @db.Date
  shiftType      ShiftType
  customShiftCode String?    // Code of custom shift type when shiftType is CUSTOM
  isOverride     Boolean     @default(false)
  overrideReason String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Crew (denormalized for query performance)
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, isOverride])
  @@index([date])
  @@index([crewId, date])
}

enum ShiftType {
  DAY
  NIGHT
  OFF
  LEAVE
  PL_DAY
  PL_NIGHT
  VACATION
  SICK
  TRAINING
  SHUTDOWN
  CUSTOM
}

// Custom roles that organizations can create
model CustomRole {
  id           String   @id @default(cuid())
  name         String   // Role name like "Team Lead", "Senior Operator"
  description  String?
  color        String   @default("#6b7280") // Hex color for display
  baseRole     UserRole @default(WORKER)    // Base permission level
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Users with this role
  users User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Custom shift types that organizations can create
model CustomShiftType {
  id           String   @id @default(cuid())
  code         String   // Short code like "BRV", "JD", "MED"
  name         String   // Full name like "Bereavement", "Jury Duty"
  color        String   @default("#6b7280") // Hex color for display
  textColor    String   @default("#ffffff") // Text color for contrast
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Certification types that organizations can define
model CertificationType {
  id          String   @id @default(cuid())
  name        String   // e.g., "Forklift Operator", "Food Safety", "First Aid"
  description String?
  color       String   @default("#3B82F6") // Hex color for display
  isRequired  Boolean  @default(false)     // Required for all workers?
  isActive    Boolean  @default(true)

  // Schedule staffing requirements
  requireOnSchedule Boolean @default(false)  // Must have worker with this cert on shift?
  minPerDayShift    Int     @default(1)      // Minimum workers on day shift
  minPerNightShift  Int     @default(1)      // Minimum workers on night shift

  // Expiry reminders (days before expiry)
  expiryWarningDays Int     @default(180)    // Default 6 months warning

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Users with this certification
  userCertifications UserCertification[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Junction table for user certifications
model UserCertification {
  id        String    @id @default(cuid())
  earnedAt  DateTime  @default(now())  // When certification was earned
  expiresAt DateTime?                   // Optional expiration date
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Certification type
  certificationTypeId String
  certificationType   CertificationType @relation(fields: [certificationTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, certificationTypeId])
  @@index([userId])
  @@index([certificationTypeId])
}

model TimeOffRequest {
  id          String            @id @default(cuid())
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  type        TimeOffType
  status      RequestStatus     @default(PENDING)
  reason      String?
  notes       String?
  adminNotes  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Requester
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Approver
  approvedById String?
  approvedBy   User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  BEREAVEMENT
  JURY_DUTY
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// =====================
// Staffing Rules & Alerts
// =====================

model StaffingRule {
  id           String        @id @default(cuid())
  name         String
  description  String?
  shiftType    ShiftType
  minWorkers   Int
  maxVacation  Int           @default(1)
  role         UserRole?     // If set, rule applies only to this role
  positionType PositionType? // If set, rule applies only to this position type
  priority     Int           @default(0) // Higher priority rules take precedence
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional crew-specific rule
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Shutdown {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// =====================
// Holiday Tracking
// =====================

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Tracking
  tracking HolidayTracking[]

  @@unique([organizationId, name, date])
  @@index([organizationId])
}

model HolidayTracking {
  id        String   @id @default(cuid())
  year      Int
  worked    Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Holiday
  holidayId String
  holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([userId, holidayId, year])
}

// =====================
// Notifications
// =====================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

enum NotificationType {
  SCHEDULE_CHANGE
  TIME_OFF_REQUEST
  TIME_OFF_APPROVED
  TIME_OFF_DENIED
  STAFFING_ALERT
  SHIFT_SWAP
  SYSTEM
}

// =====================
// Invitations
// =====================

model Invitation {
  id        String           @id @default(cuid())
  email     String
  role      UserRole         @default(WORKER)
  token     String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Created by
  createdById String
  createdBy   User   @relation("InvitationCreator", fields: [createdById], references: [id])

  @@unique([organizationId, email])
  @@index([organizationId])
}

// =====================
// AI Assistant
// =====================

model AIChatSession {
  id        String   @id @default(cuid())
  title     String?  // Auto-generated from first message
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // User who created the session
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Messages
  messages AIChatMessage[]

  @@index([organizationId])
  @@index([userId])
}

model AIChatMessage {
  id        String   @id @default(cuid())
  role      String   // "user" or "assistant"
  content   String   @db.Text
  toolCalls Json?    // Store tool calls for assistant messages
  createdAt DateTime @default(now())

  // Session
  sessionId String
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// =====================
// Audit Logging
// =====================

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g., "USER_CREATED", "SCHEDULE_UPDATED"
  entity    String   // e.g., "User", "Schedule"
  entityId  String?  // ID of the affected entity
  details   Json?    // Additional details about the action
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // User who performed the action
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

// =====================
// Shift Swap Requests
// =====================

model ShiftSwapRequest {
  id        String          @id @default(cuid())
  date      DateTime        @db.Date
  shiftType ShiftType
  reason    String?
  status    ShiftSwapStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Requester (user who wants to swap)
  requesterId String
  requester   User   @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  // Target user (user being asked to swap with)
  targetUserId String
  targetUser   User   @relation("SwapTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Approver (admin/supervisor who approved/denied)
  approvedById String?
  approvedBy   User?    @relation("SwapApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  @@index([organizationId])
  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
}

enum ShiftSwapStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}
