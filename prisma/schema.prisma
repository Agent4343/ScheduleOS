// ShiftSync Database Schema
// AI-Powered Workforce Scheduling Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// Authentication & Users
// =====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// Core Business Entities
// =====================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users            User[]
  crews            Crew[]
  rotationPatterns RotationPattern[]
  staffingRules    StaffingRule[]
  shutdowns        Shutdown[]
  holidays         Holiday[]
  invitations      Invitation[]
  customShiftTypes CustomShiftType[]
  aiChatSessions   AIChatSession[]
  shiftSwaps       ShiftSwap[]
  announcements    Announcement[]
  auditLogs        AuditLog[]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          UserRole     @default(WORKER)
  position      String?
  positionType  PositionType @default(OTHER)
  phone         String?
  hireDate      DateTime?
  status        UserStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Organization
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Crew assignment
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id])

  // Relations
  accounts           Account[]
  sessions           Session[]
  schedules          Schedule[]
  timeOffRequests    TimeOffRequest[]
  approvedRequests   TimeOffRequest[]  @relation("ApprovedBy")
  holidayTracking    HolidayTracking[]
  notifications      Notification[]
  createdInvitations Invitation[]      @relation("InvitationCreator")
  checkIns           ShiftCheckIn[]
  scannedCheckIns    ShiftCheckIn[]    @relation("ScannedBy")
  aiChatSessions     AIChatSession[]
  shiftSwapRequests  ShiftSwap[]       @relation("SwapRequester")
  shiftSwapTargets   ShiftSwap[]       @relation("SwapTarget")
  announcements      Announcement[]    @relation("AnnouncementAuthor")
  auditLogs          AuditLog[]        @relation("AuditLogUser")

  @@index([organizationId])
  @@index([crewId])
}

enum UserRole {
  ADMIN
  SUPERVISOR
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

// Position types for categorizing workers
enum PositionType {
  OPERATOR
  ONSHORE_CONTROL_ROOM
  OTHER
}

model Crew {
  id           String   @id @default(cuid())
  name         String
  description  String?
  color        String   @default("#3B82F6")
  /// Display only. Derived from the anchor when one is set; see src/lib/scheduling.ts.
  currentPhase Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Rotation anchor: fixes where this crew is in its cycle so that regenerating
  // any date range always produces the same rotation.
  /// A date on which the crew's phase is known
  rotationAnchorDate DateTime?  @db.Date
  /// Day-in-cycle (0-based) on rotationAnchorDate
  anchorPhase        Int        @default(0)
  /// Shift of the first working block on/after the anchor (alternating patterns)
  anchorStartingShift ShiftType?

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Rotation Pattern
  rotationPatternId String?
  rotationPattern   RotationPattern? @relation(fields: [rotationPatternId], references: [id])

  // Relations
  workers       User[]
  schedules     Schedule[]
  staffingRules StaffingRule[]

  @@unique([organizationId, name])
}

model RotationPattern {
  id                String   @id @default(cuid())
  name              String
  description       String?
  daysOn            Int
  daysOff           Int
  includesNights    Boolean  @default(false)
  nightsAtStart     Boolean  @default(true)
  nightDays         Int      @default(0)
  alternatesShifts  Boolean  @default(false) // When true, work periods alternate between all-DAY and all-NIGHT
  patternDefinition Json     @default("[]")
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  crews Crew[]

  @@unique([organizationId, name])
}

// =====================
// Attendance / Check-In
// =====================

model ShiftCheckIn {
  id             String    @id @default(cuid())
  date           DateTime  @db.Date
  checkInTime    DateTime
  checkOutTime   DateTime?
  autoCheckedOut Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // User who checked in
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Who performed the scan (supervisor/admin or self)
  scannedById String?
  scannedBy   User?   @relation("ScannedBy", fields: [scannedById], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// =====================
// Scheduling
// =====================

model Schedule {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  shiftType       ShiftType
  customShiftCode String? // Code of custom shift type when shiftType is CUSTOM
  isOverride      Boolean   @default(false)
  overrideReason  String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Crew (denormalized for query performance)
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, isOverride])
  @@index([date])
  @@index([crewId, date])
}

enum ShiftType {
  DAY
  NIGHT
  OFF
  LEAVE
  PL_DAY
  PL_NIGHT
  VACATION
  SICK
  TRAINING
  SHUTDOWN
  CUSTOM
}

// Custom shift types that organizations can create
model CustomShiftType {
  id          String   @id @default(cuid())
  code        String // Short code like "BRV", "JD", "MED"
  name        String // Full name like "Bereavement", "Jury Duty"
  color       String   @default("#6b7280") // Hex color for display
  textColor   String   @default("#ffffff") // Text color for contrast
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model TimeOffRequest {
  id         String        @id @default(cuid())
  startDate  DateTime      @db.Date
  endDate    DateTime      @db.Date
  type       TimeOffType
  status     RequestStatus @default(PENDING)
  reason     String?
  notes      String?
  adminNotes String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Requester
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Approver
  approvedById String?
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  BEREAVEMENT
  JURY_DUTY
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// =====================
// Staffing Rules & Alerts
// =====================

model StaffingRule {
  id           String        @id @default(cuid())
  name         String
  description  String?
  shiftType    ShiftType
  minWorkers   Int
  maxVacation  Int           @default(1)
  role         UserRole? // If set, rule applies only to this role
  positionType PositionType? // If set, rule applies only to this position type
  priority     Int           @default(0) // Higher priority rules take precedence
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional crew-specific rule
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
}

model Shutdown {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// =====================
// Holiday Tracking
// =====================

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Tracking
  tracking HolidayTracking[]

  @@unique([organizationId, name, date])
}

model HolidayTracking {
  id        String   @id @default(cuid())
  year      Int
  worked    Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Holiday
  holidayId String
  holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([userId, holidayId, year])
}

// =====================
// Notifications
// =====================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

enum NotificationType {
  SCHEDULE_CHANGE
  TIME_OFF_REQUEST
  TIME_OFF_APPROVED
  TIME_OFF_DENIED
  STAFFING_ALERT
  SHIFT_SWAP
  SYSTEM
}

// =====================
// Invitations
// =====================

model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      UserRole @default(WORKER)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Created by
  createdById String
  createdBy   User   @relation("InvitationCreator", fields: [createdById], references: [id])

  @@unique([organizationId, email])
}

// =====================
// AI Assistant
// =====================

model AIChatSession {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // User who created the session
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Messages
  messages AIChatMessage[]

  @@index([organizationId])
  @@index([userId])
}

model AIChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String   @db.Text
  toolCalls Json?
  createdAt DateTime @default(now())

  // Session
  sessionId String
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// =====================
// Shift Swaps
// =====================

model ShiftSwap {
  id        String     @id @default(cuid())
  date      DateTime   @db.Date
  shiftType ShiftType
  reason    String?    @db.Text
  status    SwapStatus @default(PENDING)
  adminNote String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Requester (who wants to swap)
  requesterId String
  requester   User   @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  // Target (who they want to swap with)
  targetId String
  target   User   @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

enum SwapStatus {
  PENDING
  ACCEPTED
  DECLINED
  APPROVED
  CANCELLED
}

// =====================
// Team Announcements
// =====================

model Announcement {
  id        String               @id @default(cuid())
  title     String
  content   String               @db.Text
  priority  AnnouncementPriority @default(NORMAL)
  pinned    Boolean              @default(false)
  expiresAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Author
  authorId String
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, pinned])
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// =====================
// Audit Log
// =====================

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // User who performed the action
  userId String
  user   User   @relation("AuditLogUser", fields: [userId], references: [id], onDelete: Cascade)

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([userId])
}
