// ShiftSync Database Schema
// AI-Powered Workforce Scheduling Platform for Offshore Operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// Authentication & Users
// =====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// Core Business Entities
// =====================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe billing
  stripeCustomerId     String?   @unique
  stripePriceId        String?
  stripeSubscriptionId String?   @unique
  plan                 PlanType  @default(FREE)
  planPeriodEnd        DateTime?

  // Relations
  users            User[]
  crews            Crew[]
  rotationPatterns RotationPattern[]
  staffingRules    StaffingRule[]
  shutdowns        Shutdown[]
  holidays         Holiday[]
  invitations      Invitation[]
  positions        Position[]
  subscription     Subscription?
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  image          String?
  role           UserRole   @default(WORKER)
  position       String?
  phone          String?
  hireDate       DateTime?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Offshore specific fields
  rotationGroup    String?   // 151, 351, 352, 451, OCR
  primaryPosition  String?   // OIM, Production Supervisor, Production Lead, OCR Operator, Ops Tech

  // Qualifications (stored as JSON array for flexibility)
  qualifications   Json      @default("[]") // ["CCR", "PS_CAPABLE", "PL_CAPABLE"]
  isCCRQualified   Boolean   @default(false) // CCR trained (marked with * in spec)
  isPSCapable      Boolean   @default(false) // Can backfill Production Supervisor
  isPLCapable      Boolean   @default(false) // Can backfill Production Lead

  // Organization
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Crew/Rotation Group assignment
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id])

  // Relations
  accounts           Account[]
  sessions           Session[]
  schedules          Schedule[]
  timeOffRequests    TimeOffRequest[]
  approvedRequests   TimeOffRequest[] @relation("ApprovedBy")
  holidayTracking    HolidayTracking[]
  notifications      Notification[]
  createdInvitations Invitation[] @relation("InvitationCreator")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

// Crew model now represents Rotation Groups (151, 351, 352, 451, OCR)
model Crew {
  id           String   @id @default(cuid())
  name         String
  code         String?  // Rotation group code: 151, 351, 352, 451, OCR
  description  String?
  color        String   @default("#3B82F6")
  currentPhase Int      @default(0)

  // Rotation behavior
  alternatesDayNight Boolean @default(false) // 351/352/451 groups alternate full hitches

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Rotation Pattern
  rotationPatternId String?
  rotationPattern   RotationPattern? @relation(fields: [rotationPatternId], references: [id])

  // Relations
  workers   User[]
  schedules Schedule[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model RotationPattern {
  id                String   @id @default(cuid())
  name              String
  description       String?
  daysOn            Int
  daysOff           Int
  includesNights    Boolean  @default(false)
  nightsAtStart     Boolean  @default(true)
  nightDays         Int      @default(0)
  patternDefinition Json     @default("[]")
  isDefault         Boolean  @default(false)

  // New: Alternating behavior for offshore rotations
  alternatesDayNight Boolean @default(false) // Full hitch alternates D/N

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  crews Crew[]

  @@unique([organizationId, name])
}

// =====================
// Positions (for staffing requirements)
// =====================

model Position {
  id                    String   @id @default(cuid())
  name                  String   // OIM, Production Supervisor, Production Lead Days, OCR-D Slot 1, etc.
  code                  String?  // Short code
  category              String?  // Field Ops, Control Room, Leadership
  shiftType             String   // day, night, 24hr
  minStaffing           Int      @default(1)
  maxStaffing           Int      @default(1)
  requiredQualifications Json    @default("[]") // ["CCR"] for CCR positions
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

// =====================
// Scheduling
// =====================

model Schedule {
  id             String    @id @default(cuid())
  date           DateTime  @db.Date
  shiftType      ShiftType
  isOverride     Boolean   @default(false)
  overrideReason String?
  notes          String?

  // Backfill tracking
  isBackfill     Boolean   @default(false)
  backfillRole   String?   // PS, PL-D, PL-N when acting up

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Crew (denormalized for query performance)
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id])

  @@unique([userId, date])
  @@index([date])
  @@index([crewId, date])
  @@index([shiftType, date])
}

// Expanded shift types for offshore operations
enum ShiftType {
  // Field Operations
  DAY       // D - Day shift outside operations
  NIGHT     // N - Night shift outside operations

  // Control Room
  OCR_DAY   // OCR-D - Operations Control Room Day
  OCR_NIGHT // OCR-N - Operations Control Room Night
  CCR_DAY   // CCR-D - Central Control Room Day
  CCR_NIGHT // CCR-N - Central Control Room Night

  // Backfill/Acting Roles (tracked via isBackfill + backfillRole)
  PS        // Production Supervisor (acting/backfill)
  PL_DAY    // PL-D - Production Lead Day (acting/backfill)
  PL_NIGHT  // PL-N - Production Lead Night (acting/backfill)

  // Non-operational
  TRAINING  // TR - Training
  OSCC      // Offshore Safety & Competence Course

  // Absence
  OFF       // Off rotation / home (blank in original)
  LEAVE     // L - Scheduled leave
  SICK      // SL - Sick Leave / Special Leave
  VACATION  // Vacation

  // Other
  SHUTDOWN  // Facility shutdown
}

model TimeOffRequest {
  id          String        @id @default(cuid())
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  type        TimeOffType
  status      RequestStatus @default(PENDING)
  reason      String?
  notes       String?
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Requester
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Approver
  approvedById String?
  approvedBy   User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  BEREAVEMENT
  JURY_DUTY
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// =====================
// Staffing Rules & Alerts
// =====================

model StaffingRule {
  id          String    @id @default(cuid())
  name        String
  shiftType   ShiftType
  minWorkers  Int
  maxVacation Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model Shutdown {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// =====================
// Holiday Tracking
// =====================

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Tracking
  tracking HolidayTracking[]

  @@unique([organizationId, name, date])
}

model HolidayTracking {
  id        String   @id @default(cuid())
  year      Int
  worked    Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Holiday
  holidayId String
  holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([userId, holidayId, year])
}

// =====================
// Notifications
// =====================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

enum NotificationType {
  SCHEDULE_CHANGE
  TIME_OFF_REQUEST
  TIME_OFF_APPROVED
  TIME_OFF_DENIED
  STAFFING_ALERT
  SHIFT_SWAP
  SYSTEM
}

// =====================
// Invitations
// =====================

model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      UserRole @default(WORKER)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Created by
  createdById String
  createdBy   User   @relation("InvitationCreator", fields: [createdById], references: [id])

  @@unique([organizationId, email])
}

// =====================
// Billing & Subscriptions
// =====================

model Subscription {
  id                   String             @id @default(cuid())
  stripeSubscriptionId String             @unique
  stripePriceId        String
  stripeCustomerId     String
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Organization
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  TRIALING
  UNPAID
}
